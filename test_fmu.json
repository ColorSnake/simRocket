            "path": "build/fmu/imu_sensor.fmu",
            "update_rate_hz": 1000.0,
            "parameters": {
                "param.gyro_noise_std": 0.005,
                "param.accel_noise_std": 0.05
            },
            "inputs": {
                "in.gyro_x": "truth.gyro_body.x",
                "in.gyro_y": "truth.gyro_body.y",
                "in.gyro_z": "truth.gyro_body.z",
                "in.accel_x": "truth.specific_force_body.x",
                "in.accel_y": "truth.specific_force_body.y",
                "in.accel_z": "truth.specific_force_body.z"
            },
            "outputs": {
                "out.gyro_x": "external.imu.gyro.x",
                "out.gyro_y": "external.imu.gyro.y",
                "out.gyro_z": "external.imu.gyro.z",
                "out.accel_x": "external.imu.accel.x",
                "out.accel_y": "external.imu.accel.y",
                "out.accel_z": "external.imu.accel.z"
            },
            "units": {
                "external.imu.gyro.x": "rad/s",
                "external.imu.gyro.y": "rad/s",
                "external.imu.gyro.z": "rad/s",
                "external.imu.accel.x": "m/s^2",
                "external.imu.accel.y": "m/s^2",
                "external.imu.accel.z": "m/s^2"
            },
            "publish": {
                "type": "imu",
                "gyro": [
                    "external.imu.gyro.x",
                    "external.imu.gyro.y",
                    "external.imu.gyro.z"
                ],
                "accel": [
                    "external.imu.accel.x",
                    "external.imu.accel.y",
                    "external.imu.accel.z"
                ]
            }
        }
    },
